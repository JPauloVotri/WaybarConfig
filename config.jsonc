// -*- mode: jsonc -*-
{
  "exclusive": true,
  "modules-left": [
    "hyprland/workspaces",
    "hyprland/window",
    "custom/bar#right"
  ],
  "modules-center": ["custom/bar#left", "mpris", "custom/bar#right"],
  "modules-right": [
    "custom/bar#left",
    "custom/temp#cpu",
    "custom/temp#gpu",
    "cpu",
    "memory",
    "custom/disk",
    "clock",
    "group/tray-expand",
    "custom/updates",
    "group/pagroup",
    "idle_inhibitor",
    "custom/notification",
    "battery",
    "custom/power"
  ],
  "custom/bar#left": {
    "format": "",
    "tooltip": false
  },
  "custom/bar#right": {
    "format": "",
    "tooltip": false
  },
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "1": "",
      "2": "",
      "3": "",
      "4": "󰇮",
      "5": ""
    },
    "all-outputs": true,
    "persistent-workspaces": {
      "*": [1, 2, 3, 4, 5]
    }
  },
  "hyprland/window": {
    "separate-outputs": true,
    "icon": true,
    "icon-size": 16,
    "max-length": 50,
    "rewrite": {
      "(.*) — Zen Browser": "$1",
      "(.*) — Mozilla Firefox": "$1",
      "(.*) - Visual Studio Code": "$1"
    }
  },
  "custom/updates": {
    "format": "<span size='12000'>{icon}</span>{0}",
    "return-type": "json",
    "format-icons": {
      "pending-updates": " ",
      "updated": ""
    },
    "exec-if": "which waybar-updates",
    "exec": "waybar-updates -l 20",
    "on-click": "kitty -e bash -c 'yay -Syu; read -p \"Pressione Enter para sair...\"'"
  },
  "idle_inhibitor": {
    "tooltip": false,
    "format": "<span size='12000'>{icon}</span>",
    "format-icons": {
      "activated": "󰈈",
      "deactivated": "󰈉"
    }
  },
  "custom/keyd-layer": {
    "exec": "~/.config/waybar/scripts/keyd-layer.sh",
    "return-type": "json",
    "restart-interval": 0,
    "format": "<span size='15000'>󰌌</span>"
  },
  "custom/temp#cpu": {
    "exec": "~/.config/waybar/scripts/cpu-temp.sh",
    "interval": 2,
    "format": " {}󰔄",
    "return-type": "json"
  },
  "custom/temp#gpu": {
    "exec": "~/.config/waybar/scripts/gpu-temp.sh",
    "interval": 2,
    "format": " {}󰔄",
    "return-type": "json"
  },
  "custom/notification": {
    "tooltip": false,
    "format": "<span size='12000'>{icon}</span>",
    "format-icons": {
      "notification": "󱅫",
      "none": "󰂚",
      "dnd-notification": "󱅫",
      "dnd-none": "󰂛",
      "inhibited-notification": "",
      "inhibited-none": "",
      "dnd-inhibited-notification": "",
      "dnd-inhibited-none": ""
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },
  "group/tray-expand": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 600,
      "children-class": "not-power",
      "transition-to-left": true
    },
    "modules": ["custom/menu", "tray"]
  },
  "custom/menu": {
    "format": "󰅃",
    "tooltip": false,
    "rotate": 90
  },
  "network": {
    "format": "{ifname}",
    "format-wifi": "{icon}",
    "format-ethernet": "",
    "format-disconnected": "󰣼",
    "tooltip-format": "{ipaddr}  {bandwidthUpBits}  {bandwidthDownBits}",
    "format-linked": "",
    "tooltip-format-wifi": "{essid} {icon} {signalStrength}%",
    "tooltip-format-ethernet": "{ifname} ",
    "tooltip-format-disconnected": "󰣼 Desconectado",
    "max-lenght": 30,
    "format-icons": ["󰣾", "󰣴", "󰣶", "󰣸", "󰣺"]
  },
  "network#speed": {
    "interval": 1,
    "format": "{ifname}",
    "format-wifi": " {bandwidthUpBytes}  {bandwidthDownBytes}",
    "format-ethernet": " {bandwidthUpBytes}  {bandwidthDownBytes}",
    "format-disconnected": " 0.00B/s  0.00B/s",
    "tooltip-format": "{ipaddr}",
    "format-linked": "󰈁 {ifname} (No IP)",
    "tooltip-format-wifi": "{essid} {icon} {signalStrength}%",
    "tooltip-format-ethernet": "{ifname} 󰌘",
    "tooltip-format-disconnected": "󰌙 Disconnected",
    "min-length": 20,
    "max-length": 24
  },
  "group/networkmod": {
    "orientation": "horizontal",
    "modules": ["network", "network#speed"]
  },
  "pulseaudio": {
    "scroll-step": 5,
    "format": "<span size='12000'>{icon}</span>",
    "format-muted": "<span size='12000'></span>",
    "format-icons": {
      "headphone": "",
      "default": ["", "", ""]
    },
    "on-click": "pavucontrol",
    "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
  },
  "pulseaudio/slider": {
    "min": 0,
    "max": 100
  },
  "group/pagroup": {
    "orientation": "horizontal",
    "drawer": {
      "transition-left-to-right": false
    },
    "modules": ["pulseaudio", "pulseaudio/slider"]
  },
  "clock": {
    "format": "{:L%d %b %Hh%M}",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "on-scroll": 1,
      "format": {
        "days": "<span weight='normal'>{}</span>",
        "months": "<span color='#cdd6f4'><b>{}</b></span>",
        "today": "<span color='#f38ba8' weight='700'><u>{}</u></span>",
        "weekdays": "<span color='#f9e2af'><b>{}</b></span>",
        "weeks": "<span color='#a6e3a1'><b>W{}</b></span>"
      }
    },
    "actions": {
      "on-click": "mode",
      "on-click-right": "shift_reset",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    },
    "tooltip-format": "<span color='#cdd6f4' font='16'><tt><small>{calendar}</small></tt></span>"
  },
  "clock#simple": {
    "format": "  {:%Hh%M}",
    "tooltip": false
  },
  "tray": {
    "show-passive-items": true,
    "spacing": 10
  },
  "cpu": {
    "interval": 1,
    "format": "<span size='15000'>{icon}</span>",
    "format-icons": ["󰝦", "󰪞", "󰪟", "󰪠", "󰪡", "󰪢", "󰪣", "󰪤", "󰪥"]
  },
  "memory": {
    "interval": 1,
    "format": "<span size='15000'>{icon}</span>",
    "format-icons": ["󰝦", "󰪞", "󰪟", "󰪠", "󰪡", "󰪢", "󰪣", "󰪤", "󰪥"]
  },
  "custom/disk": {
    "interval": 30,
    "exec": "~/.config/waybar/scripts/disk_usage.sh",
    "return-type": "json",
    "format": "<span size='15000'>{icon}</span>",
    "format-icons": ["󰝦", "󰪞", "󰪟", "󰪠", "󰪡", "󰪢", "󰪣", "󰪤", "󰪥"],
    "tooltip": true,
    "tooltip-format": "{alt}"
  },
  "battery": {
    "bat": "BAT0",
    "interval": 60,
    "states": {
      "warning": 30,
      "critical": 15,
      "default": 99,
      "full": 100
    },
    "format": "<span size='12000'>{icon}</span>",
    "format-icons": {
      "default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
      "charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"]
    },
    "tooltip": true,
    "tooltip-format": "{capacity}% - {timeTo}",
    "max-length": 25
  },
  "custom/power": {
    "format": "<span size='12000'>⏻</span>",
    "tooltip": false,
    "on-click": "~/.config/rofi/scripts/powermenu/script.sh"
  },
  "bluetooth": {
    "format": " {status}",
    "format-connected": " {device_alias}",
    "format-connected-battery": " {device_alias} {device_battery_percentage}%",
    "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%"
  },
  "mpris": {
    "player": "spotify",
    "dynamic-order": ["artist", "title"],
    "format": "{player_icon} {dynamic}",
    "format-paused": "{status_icon} <i>{dynamic}</i>",
    "max-length": 50,
    "tooltip-format": "{player_icon} {position}/{length}",
    "tooltip": false,
    "status-icons": {
      "paused": " "
    },
    "player-icons": {
      "default": " "
    }
  },
  "custom/sep": {
    "format": "|",
    "tooltip": false
  }
}
