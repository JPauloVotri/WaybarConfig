// -*- mode: jsonc -*-
{
  "margin-top": 8,
  "modules-left": [
    "group/system",
    "hyprland/window"
  ],
  "modules-center": [
    "hyprland/workspaces"
  ],
  "modules-right": [
    "group/tray-expand",
    "custom/updates",
    "custom/temp#cpu",
    "custom/temp#gpu",
    "cpu",
    "memory",
    "custom/disk",
    "mpris",
    "group/pulseaudio-expand",
    "bluetooth",
    "group/network-expand",
    "group/battery-group",
    "clock"
  ],
  "group/system": {
    "orientation": "horizontal",
    "drawer": {},
    "modules": [
      "custom/menu",
      "custom/power",
      "idle_inhibitor",
      "custom/screenshot"
    ]
  },
  "custom/menu": {
    "on-click": "$HOME/.config/rofi/scripts/launcher/script.sh",
    "format": "<span size='11000'>󰣇</span>",
    "tooltip": false
  },
  "custom/power": {
    "format": "<span size='10000'>⏻</span>",
    "tooltip": false,
    "on-click": "~/.config/rofi/scripts/powermenu/script.sh"
  },
  "idle_inhibitor": {
    "tooltip": true,
    "format": "<span size='11000'>{icon}</span>",
    "format-icons": {
      "activated": "󰈈",
      "deactivated": "󰈉"
    },
    "tooltip-format-activated": "Ativado",
    "tooltip-format-deactivated": "Desativado"
  },
  "custom/screenshot": {
    "format": "<span size='11000'>󰹑</span>",
    "tooltip": false,
    "on-click": "$HOME/.config/rofi/scripts/screenshot/script.sh"
  },
  "hyprland/window": {
    "separate-outputs": true,
    "icon": true,
    "icon-size": 12,
    "max-length": 48,
    "rewrite": {
      "(.*) — Zen Browser": "$1",
      "(.*) — Mozilla Firefox": "$1",
      "(.*) - Visual Studio Code": "$1"
    }
  },

  "clock": {
    "format": "{:%Hh%M}",
    "tooltip-format": "<span font='12'><tt>{calendar}</tt></span>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "format": {
        "days": "<span weight='normal'>{}</span>",
        "months": "<span color='#89b4fa'><b>{}</b></span>",
        "today": "<span color='#cba6f7' weight='900'>{}</span>",
        "weekdays": "<span color='#f9e2af'><b>{}</b></span>"
      }
    },
    "actions": {
      "on-click": "mode",
      "on-click-right": "shift_reset",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },
  "hyprland/workspaces": {
    "format": "{icon}",
    "all-outputs": true,
    "persistent-workspaces": {
      "*": [1, 2, 3, 4, 5]
    }
  },
  "mpris": {
    "player": "spotify",
    "dynamic-order": ["artist", "title"],
    "format": "<span size='11000'>󰓇</span>",
    "tooltip-format": "{dynamic}"
  },
  "pulseaudio": {
    "scroll-step": 5,
    "format": "{icon}",
    "format-muted": "",
    "format-icons": {
      "headphone": "",
      "default": ["", "", ""]
    },
    "tooltip-format": "{desc} - {volume}%",
    "on-click": "pavucontrol",
    "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
  },
  "pulseaudio/slider": {
    "min": 0,
    "max": 100
  },
  "group/pulseaudio-expand": {
    "orientation": "horizontal",
    "drawer": {
      "transition-left-to-right": false
    },
    "modules": ["pulseaudio", "pulseaudio/slider"]
  },
  "network#icon": {
    "format": "",
    "format-wifi": "{icon}",
    "format-ethernet": "󰌘",
    "format-disconnected": "󰌙",
    "tooltip-format": "󰊗 {ifname} via {gwaddr}",
    "tooltip-format-wifi": "{essid} ({signalStrength}%) \n{ipaddr}/{cidr}",
    "tooltip-format-ethernet": "{ifname} ",
    "tooltip-format-disconnected": "Desconectado",
    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ]
  },
  "network#name": {
    "format": "{ifname}",
    "format-wifi": "{essid}",
    "format-ethernet": "{ipaddr}/{cidr}",
    "format-disconnected": "Desconectado",
    "tooltip": false
  },
  "group/network-expand": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 600,
      "transition-left-to-right": false
    },
    "modules": ["network#icon", "network#name"]
  },
  "battery": {
    "bat": "BAT0",
    "interval": 30,
    "states": {
      "critical": 10,
      "warning": 20,
      "good": 80,
      "full": 100
    },
    "format": "{icon}",
    "format-plugged": "",
    "format-full": "",
    "format-icons": {
      "default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
      "charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"]
    },
    "format-time": "{H}h{m}",
    "tooltip": true,
    "tooltip-format": "{capacity}% - {timeTo}",
    "full-at-plugged": true
  },
  "group/battery-group": {
    "orientation": "horizontal",
    "drawer": {
      "transition-left-to-right": false
    },
    "modules": ["battery", "power-profiles-daemon"]
  },
  "bluetooth": {
    "format-on": "󰂯",
    "format-off": "󰂲",
    "format-connected": "󰂱",
    "tooltip-format": "{controller_alias}\t{controller_address}",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} conectado\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%",
    "on-click": "kitty -e bluetui",
    "on-click-right": "~/.config/waybar/scripts/toggle_bluetooth.sh"
  },
  "cpu": {
    "interval": 1,
    "format": "<span size='11000'>{icon}</span>",
    "format-icons": ["󰝦", "󰪞", "󰪟", "󰪠", "󰪡", "󰪢", "󰪣", "󰪤", "󰪥"]
  },
  "memory": {
    "interval": 1,
    "format": "<span size='11000'>{icon}</span>",
    "format-icons": ["󰝦", "󰪞", "󰪟", "󰪠", "󰪡", "󰪢", "󰪣", "󰪤", "󰪥"]
  },
  "custom/disk": {
    "interval": 30,
    "exec": "~/.config/waybar/scripts/disk_usage.sh",
    "return-type": "json",
    "format": "<span size='11000'>{icon}</span>",
    "format-icons": ["󰝦", "󰪞", "󰪟", "󰪠", "󰪡", "󰪢", "󰪣", "󰪤", "󰪥"],
    "tooltip": true,
    "tooltip-format": "{alt}"
  },
  "custom/temp#cpu": {
    "exec": "~/.config/waybar/scripts/cpu_temp.sh",
    "interval": 2,
    "format": "{icon}",
    "format-icons": {
      "low": "",
      "normal": " ",
      "warning": " ",
      "critical": " "
    },
    "return-type": "json"
  },
  "custom/temp#gpu": {
    "exec": "~/.config/waybar/scripts/gpu_temp.sh",
    "interval": 2,
    "format": "{icon}",
    "format-icons": {
      "low": "",
      "normal": " ",
      "warning": " ",
      "critical": " "
    },
    "return-type": "json"
  },
  "group/tray-expand": {
    "orientation": "horizontal",
    "drawer": {},
    "modules": ["custom/tray-arrow", "tray"]
  },
  "custom/tray-arrow": {
    "format": "",
    "tooltip": false
  },
  "tray": {
    "show-passive-items": true,
    "icon-size": 12,
    "spacing": 8
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "{profile}",
    "tooltip": true,
    "format-icons": {
      "default": "",
      "performance": "",
      "balanced": "",
      "power-saver": ""
    }
  },
  "custom/updates": {
    "format": "{icon}{0}",
    "return-type": "json",
    "format-icons": {
      "pending-updates": " ",
      "updated": ""
    },
    "exec-if": "which waybar-updates",
    "exec": "waybar-updates -l 20",
    "on-click": "kitty -e bash -c 'yay -Syu; read -p \"Pressione Enter para sair...\"'"
  }
}
